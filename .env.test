# Isolated test environment. Integration tests must never touch hiveos_dev.
# Runtime uses the least-privileged app role; migrations use the owner role.
DATABASE_URL=postgresql://hiveos_app:hiveos_app@localhost:5433/hiveos_test
DATABASE_MIGRATION_URL=postgresql://hiveos:hiveos@localhost:5433/hiveos_test
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.storage-test
DEMO_FIXTURES_ENABLED=false
BETTER_AUTH_SECRET=hiveos-test-secret-not-for-production-use
BETTER_AUTH_URL=http://localhost:3000
AUTH_ALLOW_SELF_SIGNUP=true
AUTH_RATE_LIMIT_ENABLED=false
