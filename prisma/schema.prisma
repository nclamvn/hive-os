  evidenceRetentionDays   Int                  @default(2555) @map("evidence_retention_days")
  auditRetentionDays      Int                  @default(2555) @map("audit_retention_days")
  publicReleasePolicy     PublicReleasePolicy  @default(GOVERNED_PUBLIC) @map("public_release_policy")
