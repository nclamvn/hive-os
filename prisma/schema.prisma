// HIVE OS — authoritative transactional store schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Infrastructure marker proving the migration pipeline is deterministic and
/// applied. Not a domain object; carries no product data.
model SchemaBootstrap {
  id        String   @id @default(uuid())
  note      String
  appliedAt DateTime @default(now()) @map("applied_at")

  @@map("schema_bootstrap")
}

// ---------------------------------------------------------------------------
// Authentication-owned models (Better Auth core).
// Field names match Better Auth's expected schema; columns are snake_cased.
// Better Auth owns reads/writes for these; HIVE OS never fabricates rows here.
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions                Session[]
  accounts                Account[]
  memberships             Membership[]
  organizationMemberships OrganizationMembership[]
  scopedGrants            ScopedGrant[]            @relation("ScopedGrantUser")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// HIVE OS-owned identity models. HIVE OS retains authority over workspace,
// membership, invitation, permission, and audit semantics.
// ---------------------------------------------------------------------------

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ProviderPolicyMode {
  OPEN_MANUAL
  ALLOWLIST_MANUAL
}

enum WorkspaceStorageMode {
  DATABASE
}

enum PublicReleasePolicy {
  INTERNAL_ONLY
  GOVERNED_PUBLIC
}

enum OrgUnitType {
  ROOT
  SUBSIDIARY
  BUSINESS_UNIT
  DEPARTMENT
  TEAM
}

enum EnterpriseRole {
  ORG_OWNER
  ORG_ADMIN
  PORTFOLIO_LEAD
  MISSION_OWNER
  CONTRIBUTOR
  BUILDER
  VERIFIER
  RELEASE_APPROVER
  AUDITOR
  VIEWER
}

enum GrantEffect {
  ALLOW
  DENY
}

enum GrantSubjectType {
  USER
  GROUP
}

enum GrantScopeType {
  ORGANIZATION
  ORG_UNIT
  WORKSPACE
  MISSION
}

enum GrantStatus {
  ACTIVE
  REVOKED
}

enum WorkItemType {
  MISSION
  RUNTIME_OBLIGATION
  DECISION
  ESCALATION
  EXECUTION_TIP
  VERIFICATION_REPORT
}

enum AccountabilityRole {
  ACCOUNTABLE
  RESPONSIBLE
  REVIEWER
  APPROVER
  OBSERVER
}

enum WorkAssignmentStatus {
  ACTIVE
  ENDED
}

enum WorkflowDefinitionStatus {
  ACTIVE
  RETIRED
}

enum ApprovalWorkflowType {
  CONTRACT
  VERIFICATION
  RELEASE
  EXCEPTION
  CUSTOM
}

enum WorkflowApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum WorkflowApprovalDecision {
  APPROVED
  REJECTED
}

enum CommandStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

enum OutboxStatus {
  PENDING
  DISPATCHED
}

enum DurableJobStatus {
  READY
  RUNNING
  SUCCEEDED
  DEAD_LETTER
  CANCELLED
}

enum JobEventType {
  CLAIMED
  SUCCEEDED
  RETRY_SCHEDULED
  DEAD_LETTERED
  REQUEUED
  CANCELLED
}

enum ProjectionStatus {
  READY
  REBUILDING
  FAILED
}

enum LegalHoldStatus {
  ACTIVE
  RELEASED
}

enum LegalHoldScope {
  WORKSPACE
  MISSION
}

enum LifecycleDispositionStatus {
  CANDIDATE
  BLOCKED
  APPROVED
  EXECUTED
  CANCELLED
}

enum DossierExportStatus {
  READY
  RUNNING
  SUCCEEDED
  FAILED
}

enum AuthoringDocumentType {
  RESEARCH_PROPOSAL
  TECHNICAL_PROPOSAL
  CLIENT_PROPOSAL
  COURSE_DOSSIER
  RESEARCH_PAPER
  OTHER
}

enum AuthoringDocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum ResearchRunStatus {
  QUEUED
  RUNNING
  AWAITING_REVIEW
  APPROVED
  REJECTED
  FAILED
  CANCELLED
}

enum ResearchProvenance {
  VERIFIED_PRIMARY
  CLAIM
  FLAGGED
}

enum ResearchFindingKind {
  SUPPORTING
  CONFLICTING
  CONTEXT
  HONEST_NULL
}

enum ResearchDecision {
  ACCEPTED
  REJECTED
  FLAGGED
}

enum ComputationKind {
  LATEX_BUILD
  CAS
  JUPYTER
}

enum ComputationRunStatus {
  QUEUED
  RUNNING
  AWAITING_REVIEW
  APPROVED
  REJECTED
  FAILED
  CANCELLED
}

enum SandboxNetworkPolicy {
  DENY_ALL
  ALLOWLIST
}

model Organization {
  id          String          @id @default(uuid())
  slug        String          @unique
  name        String
  status      WorkspaceStatus @default(ACTIVE)
  createdById String          @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  version     Int             @default(1)

  memberships            OrganizationMembership[]
  units                  OrgUnit[]
  portfolios             Portfolio[]
  groups                 OrganizationGroup[]
  workspaces             Workspace[]
  orgUnitClosures        OrgUnitClosure[]
  policy                 OrganizationPolicy?
  scopedGrants           ScopedGrant[]
  workflowAssignments    WorkflowAssignment[]
  slaPolicies            SlaPolicy[]
  approvalChains         ApprovalChainDefinition[]
  approvalSteps          ApprovalChainStep[]
  approvalRequests       WorkflowApprovalRequest[]
  approvalActions        WorkflowApprovalAction[]
  commands               CommandRecord[]
  outboxEvents           OutboxEvent[]
  durableJobs            DurableJob[]
  jobEvents              DurableJobEvent[]
  workspaceProjections   WorkspaceOperationalProjection[]
  portfolioProjections   PortfolioOperationalProjection[]
  legalHolds             LegalHold[]
  lifecycleDispositions  LifecycleDisposition[]
  dossierExports         DossierExport[]
  dossierExportParts     DossierExportPart[]
  missionSourceRevisions MissionSourceRevision[]
  authoringDocuments     AuthoringDocument[]
  authoringRevisions     AuthoringRevision[]
  researchRuns           ResearchRun[]
  researchSources        ResearchSourceSnapshot[]
  researchFindings       ResearchFinding[]
  researchDecisions      ResearchFindingDecision[]
  computationRuns        ComputationRun[]

  @@map("organization")
}

model OrganizationMembership {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  role           Role             @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  createdById    String           @map("created_by_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  version        Int              @default(1)

  organization                Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                        User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  groupMemberships            OrganizationGroupMembership[]
  grantsIssued                ScopedGrant[]                 @relation("GrantIssuer")
  grantsRevoked               ScopedGrant[]                 @relation("GrantRevoker")
  policiesUpdated             OrganizationPolicy[]          @relation("OrganizationPolicyUpdater")
  workflowAssignmentsReceived WorkflowAssignment[]          @relation("WorkflowAssignmentAssignee")
  workflowAssignmentsCreated  WorkflowAssignment[]          @relation("WorkflowAssignmentCreator")
  workflowAssignmentsEnded    WorkflowAssignment[]          @relation("WorkflowAssignmentEnder")
  slaPoliciesCreated          SlaPolicy[]                   @relation("SlaPolicyCreator")
  approvalChainsCreated       ApprovalChainDefinition[]     @relation("ApprovalChainCreator")
  approvalRequestsCreated     WorkflowApprovalRequest[]     @relation("ApprovalRequestCreator")
  approvalActions             WorkflowApprovalAction[]      @relation("ApprovalActionActor")
  commandsIssued              CommandRecord[]               @relation("CommandActor")
  jobDispositions             DurableJobEvent[]             @relation("JobEventActor")
  legalHoldsPlaced            LegalHold[]                   @relation("LegalHoldPlacer")
  legalHoldsReleased          LegalHold[]                   @relation("LegalHoldReleaser")
  lifecycleCandidatesCreated  LifecycleDisposition[]        @relation("LifecycleCandidateCreator")
  lifecycleCandidatesApproved LifecycleDisposition[]        @relation("LifecycleCandidateApprover")
  lifecycleCandidatesExecuted LifecycleDisposition[]        @relation("LifecycleCandidateExecutor")
  dossierExportsRequested     DossierExport[]               @relation("DossierExportRequester")

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId, status])
  @@index([organizationId, role, status])
  @@map("organization_membership")
}

model OrgUnit {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  parentId       String?         @map("parent_id")
  unitKey        String          @map("unit_key")
  name           String
  type           OrgUnitType
  status         WorkspaceStatus @default(ACTIVE)
  createdById    String          @map("created_by_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  version        Int             @default(1)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent       OrgUnit?         @relation("OrgUnitTree", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict)
  children     OrgUnit[]        @relation("OrgUnitTree")
  workspaces   Workspace[]
  portfolios   Portfolio[]
  ancestors    OrgUnitClosure[] @relation("OrgUnitAncestor")
  descendants  OrgUnitClosure[] @relation("OrgUnitDescendant")
  scopedGrants ScopedGrant[]

  @@unique([organizationId, unitKey])
  @@unique([organizationId, id])
  @@index([organizationId, parentId, status])
  @@map("org_unit")
}

model OrgUnitClosure {
  organizationId String @map("organization_id")
  ancestorId     String @map("ancestor_id")
  descendantId   String @map("descendant_id")
  depth          Int

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ancestor     OrgUnit      @relation("OrgUnitAncestor", fields: [organizationId, ancestorId], references: [organizationId, id], onDelete: Cascade)
  descendant   OrgUnit      @relation("OrgUnitDescendant", fields: [organizationId, descendantId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, ancestorId, descendantId])
  @@index([organizationId, descendantId, depth])
  @@index([organizationId, ancestorId, depth])
  @@map("org_unit_closure")
}

model Portfolio {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  orgUnitId      String          @map("org_unit_id")
  portfolioKey   String          @map("portfolio_key")
  name           String
  status         WorkspaceStatus @default(ACTIVE)
  createdById    String          @map("created_by_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  version        Int             @default(1)

  organization                    Organization                     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orgUnit                         OrgUnit                          @relation(fields: [organizationId, orgUnitId], references: [organizationId, id], onDelete: Restrict)
  workspaces                      Workspace[]
  operationalProjection           PortfolioOperationalProjection?
  workspaceOperationalProjections WorkspaceOperationalProjection[]

  @@unique([organizationId, portfolioKey])
  @@unique([organizationId, id])
  @@index([organizationId, orgUnitId, status])
  @@map("portfolio")
}

model OrganizationGroup {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  groupKey       String           @map("group_key")
  name           String
  status         MembershipStatus @default(ACTIVE)
  createdById    String           @map("created_by_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  version        Int              @default(1)

  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships  OrganizationGroupMembership[]
  scopedGrants ScopedGrant[]                 @relation("ScopedGrantGroup")

  @@unique([organizationId, groupKey])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("organization_group")
}

model OrganizationGroupMembership {
  id                       String   @id @default(uuid())
  organizationId           String   @map("organization_id")
  groupId                  String   @map("group_id")
  organizationMembershipId String   @map("organization_membership_id")
  createdById              String   @map("created_by_id")
  createdAt                DateTime @default(now()) @map("created_at")

  organizationMembership OrganizationMembership @relation(fields: [organizationId, organizationMembershipId], references: [organizationId, id], onDelete: Cascade)
  group                  OrganizationGroup      @relation(fields: [organizationId, groupId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, groupId, organizationMembershipId])
  @@index([organizationId, organizationMembershipId])
  @@map("organization_group_membership")
}

model OrganizationPolicy {
  organizationId                    String   @id @map("organization_id")
  requireIndependentVerification    Boolean  @default(true) @map("require_independent_verification")
  requireIndependentReleaseApproval Boolean  @default(true) @map("require_independent_release_approval")
  preventSelfApproval               Boolean  @default(true) @map("prevent_self_approval")
  maxDelegationDepth                Int      @default(8) @map("max_delegation_depth")
  updatedByOrganizationMembershipId String?  @map("updated_by_organization_membership_id")
  createdAt                         DateTime @default(now()) @map("created_at")
  updatedAt                         DateTime @updatedAt @map("updated_at")
  version                           Int      @default(1)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  updatedBy    OrganizationMembership? @relation("OrganizationPolicyUpdater", fields: [organizationId, updatedByOrganizationMembershipId], references: [organizationId, id], onDelete: Restrict)

  @@map("organization_policy")
}

model ScopedGrant {
  id                                String           @id @default(uuid())
  organizationId                    String           @map("organization_id")
  subjectType                       GrantSubjectType @map("subject_type")
  subjectUserId                     String?          @map("subject_user_id")
  subjectGroupId                    String?          @map("subject_group_id")
  role                              EnterpriseRole
  effect                            GrantEffect      @default(ALLOW)
  scopeType                         GrantScopeType   @map("scope_type")
  orgUnitId                         String?          @map("org_unit_id")
  workspaceId                       String?          @map("workspace_id")
  missionId                         String?          @map("mission_id")
  delegatedFromGrantId              String?          @map("delegated_from_grant_id")
  grantedByOrganizationMembershipId String           @map("granted_by_organization_membership_id")
  reason                            String
  validFrom                         DateTime         @default(now()) @map("valid_from")
  validUntil                        DateTime?        @map("valid_until")
  status                            GrantStatus      @default(ACTIVE)
  revokedAt                         DateTime?        @map("revoked_at")
  revokedByOrganizationMembershipId String?          @map("revoked_by_organization_membership_id")
  createdAt                         DateTime         @default(now()) @map("created_at")
  updatedAt                         DateTime         @updatedAt @map("updated_at")
  version                           Int              @default(1)

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subjectUser   User?                   @relation("ScopedGrantUser", fields: [subjectUserId], references: [id], onDelete: Restrict)
  subjectGroup  OrganizationGroup?      @relation("ScopedGrantGroup", fields: [organizationId, subjectGroupId], references: [organizationId, id], onDelete: Restrict)
  orgUnit       OrgUnit?                @relation(fields: [organizationId, orgUnitId], references: [organizationId, id], onDelete: Restrict)
  workspace     Workspace?              @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)
  mission       Mission?                @relation(fields: [missionId], references: [id], onDelete: Restrict)
  delegatedFrom ScopedGrant?            @relation("GrantDelegation", fields: [organizationId, delegatedFromGrantId], references: [organizationId, id], onDelete: Restrict)
  delegations   ScopedGrant[]           @relation("GrantDelegation")
  grantedBy     OrganizationMembership  @relation("GrantIssuer", fields: [organizationId, grantedByOrganizationMembershipId], references: [organizationId, id], onDelete: Restrict)
  revokedBy     OrganizationMembership? @relation("GrantRevoker", fields: [organizationId, revokedByOrganizationMembershipId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, subjectUserId, status, validFrom, validUntil])
  @@index([organizationId, subjectGroupId, status, validFrom, validUntil])
  @@index([organizationId, scopeType, orgUnitId, workspaceId, missionId])
  @@index([organizationId, delegatedFromGrantId])
  @@map("scoped_grant")
}

model SlaPolicy {
  id                                String                   @id @default(uuid())
  organizationId                    String                   @map("organization_id")
  workspaceId                       String?                  @map("workspace_id")
  policyKey                         String                   @map("policy_key")
  name                              String
  targetType                        WorkItemType             @map("target_type")
  assuranceProfile                  AssuranceProfile?        @map("assurance_profile")
  dueAfterMinutes                   Int                      @map("due_after_minutes")
  warningBeforeMinutes              Int                      @map("warning_before_minutes")
  escalateAfterMinutes              Int                      @map("escalate_after_minutes")
  escalationSeverity                EscalationSeverity       @map("escalation_severity")
  status                            WorkflowDefinitionStatus @default(ACTIVE)
  createdByOrganizationMembershipId String                   @map("created_by_organization_membership_id")
  createdAt                         DateTime                 @default(now()) @map("created_at")
  updatedAt                         DateTime                 @updatedAt @map("updated_at")
  version                           Int                      @default(1)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace    Workspace?             @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)
  createdBy    OrganizationMembership @relation("SlaPolicyCreator", fields: [organizationId, createdByOrganizationMembershipId], references: [organizationId, id], onDelete: Restrict)
  assignments  WorkflowAssignment[]

  @@unique([organizationId, id])
  @@unique([organizationId, policyKey, version])
  @@index([organizationId, workspaceId, targetType, assuranceProfile, status])
  @@map("sla_policy")
}

model WorkflowAssignment {
  id                                 String               @id @default(uuid())
  organizationId                     String               @map("organization_id")
  workspaceId                        String               @map("workspace_id")
  missionId                          String               @map("mission_id")
  targetType                         WorkItemType         @map("target_type")
  targetId                           String               @map("target_id")
  accountabilityRole                 AccountabilityRole   @map("accountability_role")
  assigneeOrganizationMembershipId   String               @map("assignee_organization_membership_id")
  assignedByOrganizationMembershipId String               @map("assigned_by_organization_membership_id")
  reason                             String
  dueAt                              DateTime?            @map("due_at")
  slaPolicyId                        String?              @map("sla_policy_id")
  slaPolicyVersion                   Int?                 @map("sla_policy_version")
  validFrom                          DateTime             @default(now()) @map("valid_from")
  validUntil                         DateTime?            @map("valid_until")
  status                             WorkAssignmentStatus @default(ACTIVE)
  endedAt                            DateTime?            @map("ended_at")
  endedByOrganizationMembershipId    String?              @map("ended_by_organization_membership_id")
  createdAt                          DateTime             @default(now()) @map("created_at")
  updatedAt                          DateTime             @updatedAt @map("updated_at")
  version                            Int                  @default(1)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace    Workspace               @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)
  mission      Mission                 @relation(fields: [workspaceId, missionId], references: [workspaceId, id], onDelete: Restrict)
  assignee     OrganizationMembership  @relation("WorkflowAssignmentAssignee", fields: [organizationId, assigneeOrganizationMembershipId], references: [organizationId, id], onDelete: Restrict)
  assignedBy   OrganizationMembership  @relation("WorkflowAssignmentCreator", fields: [organizationId, assignedByOrganizationMembershipId], references: [organizationId, id], onDelete: Restrict)
  endedBy      OrganizationMembership? @relation("WorkflowAssignmentEnder", fields: [organizationId, endedByOrganizationMembershipId], references: [organizationId, id], onDelete: Restrict)
  slaPolicy    SlaPolicy?              @relation(fields: [organizationId, slaPolicyId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, workspaceId, missionId, targetType, targetId, status])
  @@index([organizationId, assigneeOrganizationMembershipId, status, dueAt, id])
  @@map("workflow_assignment")
}

model ApprovalChainDefinition {
  id                                String                   @id @default(uuid())
  organizationId                    String                   @map("organization_id")
  workspaceId                       String?                  @map("workspace_id")
  chainKey                          String                   @map("chain_key")
  name                              String
  workflowType                      ApprovalWorkflowType     @map("workflow_type")
  status                            WorkflowDefinitionStatus @default(ACTIVE)
  createdByOrganizationMembershipId String                   @map("created_by_organization_membership_id")
  createdAt                         DateTime                 @default(now()) @map("created_at")
  updatedAt                         DateTime                 @updatedAt @map("updated_at")
  version                           Int                      @default(1)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace    Workspace?                @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)
  createdBy    OrganizationMembership    @relation("ApprovalChainCreator", fields: [organizationId, createdByOrganizationMembershipId], references: [organizationId, id], onDelete: Restrict)
  steps        ApprovalChainStep[]
  requests     WorkflowApprovalRequest[]

  @@unique([organizationId, id])
  @@unique([organizationId, chainKey, version])
  @@index([organizationId, workspaceId, workflowType, status])
  @@map("approval_chain_definition")
}

model ApprovalChainStep {
  id                             String   @id @default(uuid())
  organizationId                 String   @map("organization_id")
  chainDefinitionId              String   @map("chain_definition_id")
  sequence                       Int
  name                           String
  requiredCapability             String   @map("required_capability")
  minimumApprovals               Int      @default(1) @map("minimum_approvals")
  requireIndependentFromPrevious Boolean  @default(false) @map("require_independent_from_previous")
  createdAt                      DateTime @default(now()) @map("created_at")

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  chainDefinition ApprovalChainDefinition  @relation(fields: [organizationId, chainDefinitionId], references: [organizationId, id], onDelete: Restrict)
  actions         WorkflowApprovalAction[]

  @@unique([organizationId, id])
  @@unique([chainDefinitionId, sequence])
  @@index([organizationId, chainDefinitionId, sequence])
  @@map("approval_chain_step")
}

model WorkflowApprovalRequest {
  id                                  String                 @id @default(uuid())
  organizationId                      String                 @map("organization_id")
  workspaceId                         String                 @map("workspace_id")
  missionId                           String                 @map("mission_id")
  chainDefinitionId                   String                 @map("chain_definition_id")
  targetType                          WorkItemType           @map("target_type")
  targetId                            String                 @map("target_id")
  status                              WorkflowApprovalStatus @default(PENDING)
  currentStepSequence                 Int                    @default(1) @map("current_step_sequence")
  requestedByOrganizationMembershipId String                 @map("requested_by_organization_membership_id")
  requestedAt                         DateTime               @default(now()) @map("requested_at")
  completedAt                         DateTime?              @map("completed_at")
  version                             Int                    @default(1)

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace       Workspace                @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)
  mission         Mission                  @relation(fields: [workspaceId, missionId], references: [workspaceId, id], onDelete: Restrict)
