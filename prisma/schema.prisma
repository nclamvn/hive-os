// HIVE OS — authoritative transactional store schema.
// TIP-003 scope: Identity, Workspace, and Audit. Missions, claims, evidence,
// execution, and verification arrive in their own authorized TIPs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Infrastructure marker proving the migration pipeline is deterministic and
/// applied. Not a domain object; carries no product data.
model SchemaBootstrap {
  id        String   @id @default(uuid())
  note      String
  appliedAt DateTime @default(now()) @map("applied_at")

  @@map("schema_bootstrap")
}

// ---------------------------------------------------------------------------
// Authentication-owned models (Better Auth core).
// Field names match Better Auth's expected schema; columns are snake_cased.
// Better Auth owns reads/writes for these; HIVE OS never fabricates rows here.
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// HIVE OS-owned identity models. HIVE OS retains authority over workspace,
// membership, invitation, permission, and audit semantics.
// ---------------------------------------------------------------------------

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Workspace {
  id          String          @id @default(uuid())
  slug        String          @unique
  name        String
  status      WorkspaceStatus @default(ACTIVE)
  createdById String          @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  version     Int             @default(1)

  memberships Membership[]
  invitations Invitation[]
  auditEvents AuditEvent[]
  missions    Mission[]

  @@map("workspace")
}

model Membership {
  id          String           @id @default(uuid())
  workspaceId String           @map("workspace_id")
  userId      String           @map("user_id")
  role        Role             @default(MEMBER)
  status      MembershipStatus @default(ACTIVE)
  createdById String           @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  version     Int              @default(1)

  workspace           Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuedInvitations   Invitation[] @relation("InvitationInvitedBy")

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role, status])
  @@map("membership")
}

model Invitation {
  id                    String           @id @default(uuid())
  workspaceId           String           @map("workspace_id")
  emailNormalized       String           @map("email_normalized")
  role                  Role             @default(MEMBER)
  tokenHash             String           @unique @map("token_hash")
  status                InvitationStatus @default(PENDING)
  expiresAt             DateTime         @map("expires_at")
  invitedByMembershipId String           @map("invited_by_membership_id")
  acceptedByUserId      String?          @map("accepted_by_user_id")
  acceptedAt            DateTime?         @map("accepted_at")
  createdAt             DateTime         @default(now()) @map("created_at")

  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   Membership @relation("InvitationInvitedBy", fields: [invitedByMembershipId], references: [id])

  @@index([workspaceId, status])
  @@index([emailNormalized, status])
  @@map("invitation")
}

/// Append-only. There is deliberately NO application-level update or delete
/// path, and a database trigger (migration `audit_append_only`) rejects any
/// UPDATE or DELETE. Payload is a redacted, schema-validated allowlist.
model AuditEvent {
  id                String   @id @default(uuid())
  workspaceId       String   @map("workspace_id")
  actorUserId       String?  @map("actor_user_id")
  actorMembershipId String?  @map("actor_membership_id")
  eventType         String   @map("event_type")
  entityType        String   @map("entity_type")
  entityId          String   @map("entity_id")
  correlationId     String   @map("correlation_id")
  payload           Json
  createdAt         DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([correlationId])
  @@map("audit_event")
}

// ---------------------------------------------------------------------------
// Mission Kernel (TIP-004). Immutable contract definitions are kept separate
// from mutable runtime state. Truth/Execution/Verification/Release are NOT
// implemented here; later-stage transitions fail closed.
// ---------------------------------------------------------------------------

enum MissionStatus {
  DRAFT
  INTAKE
  SCOPED
  CONTRACT_REVIEW
  APPROVED
  EXPLORING
  BUILDING
  VERIFYING
  REVIEW
  RELEASED
  PARTIAL
  BLOCKED
  REFUTED
  CANCELLED
  ARCHIVED
}

enum AssuranceProfile {
  QUICK
  PROFESSIONAL
  RESEARCH
  REGULATED
}

enum ContractStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SUPERSEDED
}

enum RequirementPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ConstraintType {
  TECHNICAL
  LEGAL
  RESOURCE
  SCHEDULE
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MissionInputType {
  TEXT
  LINK
  FILE
  DATASET
  OTHER
}

enum ObligationStatus {
  OPEN
  IN_PROGRESS
  SATISFIED
  WAIVED
  BLOCKED
}

enum GateStatus {
  OPEN
  PASSED
  FAILED
  WAIVED
}

enum GateResult {
  PASS
  FAIL
  INCOMPLETE
}

enum GateEvaluationMode {
  MANUAL
  DETERMINISTIC
}

enum ActorType {
  HUMAN_COMMAND
  DETERMINISTIC_KERNEL
}

enum DecisionType {
  CONTRACT_AMENDMENT
  SCOPE_CHANGE
  ASSURANCE_DOWNGRADE
  OBLIGATION_WAIVER
  GATE_WAIVER
  CANCELLATION
  REFUTATION
  RELEASE_EXCEPTION
}

enum DecisionStatus {
  REQUIRED
  APPROVED
  REJECTED
  CANCELLED
}

enum EscalationSeverity {
  P0
  P1
  P2
  P3
}

enum EscalationStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

/// Concurrency-safe per-workspace reference-code allocator for missions.
model WorkspaceMissionCounter {
  workspaceId String @id @map("workspace_id")
  nextRef     Int    @default(1) @map("next_ref")

  @@map("workspace_mission_counter")
}

model Mission {
  id                  String        @id @default(uuid())
  workspaceId         String        @map("workspace_id")
  referenceCode       String        @map("reference_code")
  title               String
  status              MissionStatus @default(DRAFT)
  assuranceProfile    AssuranceProfile @default(PROFESSIONAL) @map("assurance_profile")
  currentContractId   String?       @map("current_contract_id")
  approvedContractId  String?       @map("approved_contract_id")
  blockedFromStatus   MissionStatus? @map("blocked_from_status")
  idempotencyKey      String?       @map("idempotency_key")
  createdByMembershipId String      @map("created_by_membership_id")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  version             Int           @default(1)

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contracts   MissionContract[]
  obligations RuntimeObligation[]
  gates       RuntimeGate[]
  decisions   Decision[]
  escalations Escalation[]

  @@unique([workspaceId, referenceCode])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status])
  @@map("mission")
}

model MissionContract {
  id                    String         @id @default(uuid())
  workspaceId           String         @map("workspace_id")
  missionId             String         @map("mission_id")
  versionNumber         Int            @map("version_number")
  status                ContractStatus @default(DRAFT)
  objective             String
  scope                 String
  successDefinition     String         @map("success_definition")
  assuranceProfile      AssuranceProfile @map("assurance_profile")
  supersedesContractId  String?        @map("supersedes_contract_id")
  createdByMembershipId String         @map("created_by_membership_id")
  submittedByMembershipId String?      @map("submitted_by_membership_id")
  approvedByMembershipId  String?      @map("approved_by_membership_id")
  submittedAt           DateTime?      @map("submitted_at")
  approvedAt            DateTime?      @map("approved_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  version              Int            @default(1)

  mission      Mission              @relation(fields: [missionId], references: [id], onDelete: Cascade)
  requirements Requirement[]
  assumptions  Assumption[]
  constraints  Constraint[]
  inputs       MissionInput[]
  obligationDefs ContractObligation[]
  gateDefs     ContractGate[]

  @@unique([missionId, versionNumber])
  @@index([workspaceId, status])
  @@map("mission_contract")
}

model Requirement {
  id                 String              @id @default(uuid())
  workspaceId        String              @map("workspace_id")
  contractId         String              @map("contract_id")
  code               String
  title              String
  description        String
  acceptanceCriteria String              @map("acceptance_criteria")
  priority           RequirementPriority @default(MEDIUM)
  required           Boolean             @default(true)

  contract MissionContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, code])
  @@map("requirement")
}

model Assumption {
  id               String  @id @default(uuid())
  workspaceId      String  @map("workspace_id")
  contractId       String  @map("contract_id")
  statement        String
  validationMethod String? @map("validation_method")
  status           String  @default("ASSUMED")

  contract MissionContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("assumption")
}

model Constraint {
  id             String         @id @default(uuid())
  workspaceId    String         @map("workspace_id")
  contractId     String         @map("contract_id")
  statement      String
  constraintType ConstraintType @default(OTHER) @map("constraint_type")
  severity       Severity       @default(MEDIUM)

  contract MissionContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("constraint")
}

model MissionInput {
  id               String           @id @default(uuid())
  workspaceId      String           @map("workspace_id")
  contractId       String           @map("contract_id")
  label            String
  inputType        MissionInputType @default(TEXT) @map("input_type")
  description      String
  storageReference String?          @map("storage_reference")
  contentHash      String?          @map("content_hash")

  contract MissionContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("mission_input")
}

model ContractObligation {
  id          String  @id @default(uuid())
  workspaceId String  @map("workspace_id")
  contractId  String  @map("contract_id")
  code        String
  title       String
  description String
  weight      Int
  required    Boolean @default(true)
  closureRule String  @map("closure_rule")

  contract MissionContract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  runtime  RuntimeObligation[]

  @@unique([contractId, code])
  @@map("contract_obligation")
}

model ContractGate {
  id                  String             @id @default(uuid())
  workspaceId         String             @map("workspace_id")
  contractId          String             @map("contract_id")
  code                String
  title               String
  requiredBeforeStatus MissionStatus     @map("required_before_status")
  required            Boolean            @default(true)
  evaluationMode      GateEvaluationMode @default(MANUAL) @map("evaluation_mode")

  contract MissionContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  runtime  RuntimeGate[]

  @@unique([contractId, code])
  @@map("contract_gate")
}

model RuntimeObligation {
  id                   String           @id @default(uuid())
  workspaceId          String           @map("workspace_id")
  missionId            String           @map("mission_id")
  contractObligationId String           @map("contract_obligation_id")
  status               ObligationStatus @default(OPEN)
  closedByMembershipId String?          @map("closed_by_membership_id")
  closedAt             DateTime?        @map("closed_at")
  closureReason        String?          @map("closure_reason")
  version              Int              @default(1)

  mission           Mission            @relation(fields: [missionId], references: [id], onDelete: Cascade)
  contractObligation ContractObligation @relation(fields: [contractObligationId], references: [id], onDelete: Cascade)

  @@unique([missionId, contractObligationId])
  @@index([workspaceId, missionId])
  @@map("runtime_obligation")
}

model RuntimeGate {
  id             String     @id @default(uuid())
  workspaceId    String     @map("workspace_id")
  missionId      String     @map("mission_id")
  contractGateId String     @map("contract_gate_id")
  status         GateStatus @default(OPEN)
  version        Int        @default(1)

  mission      Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  contractGate ContractGate @relation(fields: [contractGateId], references: [id], onDelete: Cascade)
  runs         GateRun[]

  @@unique([missionId, contractGateId])
  @@index([workspaceId, missionId])
  @@map("runtime_gate")
}

/// Append-only evaluation attempts. INCOMPLETE never counts as PASS.
model GateRun {
  id             String     @id @default(uuid())
  workspaceId    String     @map("workspace_id")
  missionId      String     @map("mission_id")
  runtimeGateId  String     @map("runtime_gate_id")
  result         GateResult
  actorType      ActorType  @map("actor_type")
  actorId        String     @map("actor_id")
  reason         String
  linkedArtifactId String?  @map("linked_artifact_id")
  createdAt      DateTime   @default(now()) @map("created_at")

  runtimeGate RuntimeGate @relation(fields: [runtimeGateId], references: [id], onDelete: Cascade)

  @@index([workspaceId, missionId])
  @@map("gate_run")
}

model Decision {
  id                     String         @id @default(uuid())
  workspaceId            String         @map("workspace_id")
  missionId              String         @map("mission_id")
  decisionType           DecisionType   @map("decision_type")
  materiality            String         @default("MATERIAL")
  status                 DecisionStatus @default(REQUIRED)
  question               String
  proposedAction         String         @map("proposed_action")
  resolution             String?
  targetKind             String?        @map("target_kind")
  targetId               String?        @map("target_id")
  proposedProfile        AssuranceProfile? @map("proposed_profile")
  requestedByMembershipId String        @map("requested_by_membership_id")
  decidedByMembershipId  String?        @map("decided_by_membership_id")
  dueAt                  DateTime?      @map("due_at")
  decidedAt              DateTime?      @map("decided_at")
  createdAt              DateTime       @default(now()) @map("created_at")
  version                Int            @default(1)

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, missionId])
  @@map("decision")
}

model Escalation {
  id                        String             @id @default(uuid())
  workspaceId               String             @map("workspace_id")
  missionId                 String             @map("mission_id")
  severity                  EscalationSeverity
  status                    EscalationStatus   @default(OPEN)
  reason                    String
  sourceType                String             @map("source_type")
  sourceId                  String?            @map("source_id")
  createdByMembershipId     String             @map("created_by_membership_id")
  acknowledgedByMembershipId String?           @map("acknowledged_by_membership_id")
  resolvedByMembershipId    String?            @map("resolved_by_membership_id")
  createdAt                 DateTime           @default(now()) @map("created_at")
  resolvedAt                DateTime?          @map("resolved_at")
  version                   Int                @default(1)

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, missionId])
  @@map("escalation")
}
