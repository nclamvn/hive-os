FROM postgres:16-bookworm@sha256:c584152ee009674cdf8360f6292577bcf93953790e0fe742aa9d337d0b0f25ae AS postgres16-client

FROM node:24-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS deps
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates openssl \
    postgresql-client \
  && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./
RUN npm ci

FROM deps AS migrator
ARG VCS_REF=unknown
LABEL org.opencontainers.image.revision=$VCS_REF
COPY --from=postgres16-client /usr/lib/postgresql/16 /usr/lib/postgresql/16
COPY --from=postgres16-client /usr/share/postgresql/16 /usr/share/postgresql/16
ENV PATH="/usr/lib/postgresql/16/bin:${PATH}"
COPY scripts/db ./scripts/db
COPY scripts/operations/provision-service-principal.mjs ./scripts/operations/provision-service-principal.mjs
COPY tsconfig.json vitest.config.ts ./
COPY src ./src
COPY tests/scale ./tests/scale
USER node
CMD ["npm", "run", "db:bootstrap"]

FROM deps AS worker
ARG VCS_REF=unknown
LABEL org.opencontainers.image.revision=$VCS_REF
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
COPY tsconfig.json ./
COPY src ./src
COPY scripts/workers ./scripts/workers
# The worker is a separate unprivileged process. It receives runtime secrets
# only at container start and never shares the web application's filesystem.
RUN npm prune --omit=dev \
  && ./node_modules/.bin/tsx --version \
  && RUNTIME_COMPONENT=research-worker \
    NODE_ENV=test \
    DATABASE_URL=postgresql://worker:worker@localhost:5432/hiveos \
    RESEARCH_WORKER_ENABLED=true \
    RESEARCH_OPENAI_ENABLED=true \
    RESEARCH_WORKER_ORGANIZATION_ID=962e9399-d7ed-4410-a72e-37001e1fa28c \
    RESEARCH_WORKER_ACTOR_USER_ID=svc_image_contract \
    OPENAI_API_KEY=image-contract-only \
    npm run worker:research-sandbox -- --validate-startup-contract=TIP-024D
USER node
CMD ["npm", "run", "worker:research-sandbox"]

FROM node:24-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PHASE=phase-production-build
ENV DATABASE_URL=postgresql://build:build@localhost:5432/hiveos_build
COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
# next-env.d.ts is generated by Next.js and intentionally ignored by Git; the
# release build must not depend on a developer workstation copy.
COPY next.config.ts postcss.config.mjs tsconfig.json ./
COPY prisma ./prisma
COPY public ./public
COPY scripts/build ./scripts/build
COPY src ./src
# Better Auth initializes while Next collects routes. This non-secret,
# build-scoped placeholder is never copied as runtime configuration.
# Cross-architecture release builders cannot execute Turbopack's native host
# binary reliably. Next.js 16 explicitly supports Webpack as the production
# build fallback; the resulting standalone runtime contract is unchanged.
RUN BETTER_AUTH_SECRET=build-only-placeholder-never-runtime npx next build --webpack \
  && node scripts/build/scrub-standalone-env.mjs \
  && node scripts/build/prepare-standalone-assets.mjs

FROM node:24-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS runner
ARG VCS_REF=unknown
LABEL org.opencontainers.image.revision=$VCS_REF
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates openssl \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --gid 1001 hiveos \
  && useradd --uid 1001 --gid hiveos --create-home hiveos
COPY --from=builder --chown=hiveos:hiveos /app/public ./public
COPY --from=builder --chown=hiveos:hiveos /app/.next/standalone ./
COPY --from=builder --chown=hiveos:hiveos /app/.next/static ./.next/static
USER hiveos
EXPOSE 3000
CMD ["node", "server.js"]
