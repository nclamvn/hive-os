# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnpm-store/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Reusable QA/build outputs and legacy generated Next folders, never evidence.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — templates and the secret-free test env are committed
.env*
!.env.example
!.env.test

# local object storage (development/test adapters)
/.storage/
/.storage-test/

# playwright
/test-results/
/playwright-report/

# Unrun Santa Fe pilot source cache: preserve local originals and digest receipts,
# keep incidental conference attendee data and generated previews out of Git.
/artifacts/qa/holdout-operator-20261014/sources/
/artifacts/qa/holdout-operator-20261014/source-previews/

# vercel
.vercel

# typescript
*.tsbuildinfo
__pycache__/
*.py[cod]
next-env.d.ts
