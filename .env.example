# HIVE OS environment template. Copy to .env and adjust.
# Values here are development defaults only — never commit real secrets.

# --- Core ---
# Explicit runtime class. NODE_ENV remains the framework mode; staging and
# production both run with NODE_ENV=production.
DEPLOYMENT_ENV=development
# Runtime connection: MUST be a least-privileged, non-superuser role that cannot
# UPDATE/DELETE audit_event nor own/alter tables or triggers.
DATABASE_URL=postgresql://hiveos_app:hiveos_app@localhost:5433/hiveos_dev
# Owner/migration connection: used only by the Prisma CLI to run migrations and
# to configure the runtime role. Never used by the running application.
DATABASE_MIGRATION_URL=postgresql://hiveos:hiveos@localhost:5433/hiveos_dev
# Bounded application pool and query timeouts.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000

# --- Object storage ---
# STORAGE_DRIVER selects the adapter: "local" (development) or "s3" (production, S3-compatible)
STORAGE_DRIVER=local
# Root directory for the local adapter (development only)
STORAGE_LOCAL_ROOT=.storage

# Required only when STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# Required with STORAGE_DRIVER=s3. Use aws:kms plus S3_KMS_KEY_ID where the
# provider supports a customer-managed key.
# S3_SERVER_SIDE_ENCRYPTION=AES256
# S3_KMS_KEY_ID=

# --- Fixture boundary ---
# Demo fixtures load ONLY when this is exactly "true" AND NODE_ENV is not "production".
DEMO_FIXTURES_ENABLED=false
# Operator-controlled emergency boundary. Health probes remain reachable.
MAINTENANCE_MODE=false

# --- Authentication (Better Auth) ---
# Mandatory. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of the app; used for auth cookies/callbacks (same-origin).
BETTER_AUTH_URL=http://localhost:3000
# Self-sign-up: production defaults to disabled. Enable only deliberately.
AUTH_ALLOW_SELF_SIGNUP=false

# Auth request rate limiting. Can be disabled ONLY when NODE_ENV=test;
# startup validation fails if disabled in development or production.
AUTH_RATE_LIMIT_ENABLED=true
# Tunable limits (requests per window seconds). Production-safe defaults.
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW=60

# --- Identity recovery (TIP-021A) ---
# Keyed digest secret for the destination throttle and IP/user-agent digests.
# Mandatory outside NODE_ENV=test. Generate with: openssl rand -base64 32
AUTH_THROTTLE_SECRET=
# Mail boundary. "local" captures messages in a non-production sink (dev/test);
# "smtp" delivers via a real provider. Production MUST use "smtp".
MAIL_DRIVER=local
MAIL_FROM=HIVE OS <noreply@localhost>
# MAIL_REPLY_TO=
# Absolute base for recovery links. Must be https:// and share BETTER_AUTH_URL
# origin in production.
MAIL_BASE_URL=http://localhost:3000
# Required when MAIL_DRIVER=smtp:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
