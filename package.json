{
  "name": "hiveos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build/scrub-standalone-env.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:dependency-policy": "vitest run --project unit tests/unit/dependency-policy.test.ts",
    "check:dependency-policy": "node scripts/ci/check-dependency-policy.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:prod-startup": "node scripts/test/prod-fail-closed.mjs",
    "test:load-local": "node scripts/test/load-baseline.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:setup-role": "node scripts/db/apply-app-role.mjs",
    "db:bootstrap": "prisma migrate deploy && node scripts/db/apply-app-role.mjs",
    "db:backup:local": "node scripts/db/backup-local.mjs",
    "db:restore:local": "node scripts/db/restore-local.mjs",
    "db:rehearse:tip019": "node scripts/db/rehearse-tip019.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1090.0",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "better-auth": "1.6.23",
    "lucide-react": "1.25.0",
    "next": "16.2.11",
    "nodemailer": "9.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "7.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "pg": "8.22.0",
    "prisma": "7.9.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "find-my-way": "9.7.0",
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  }
}
