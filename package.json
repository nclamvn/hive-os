{
  "name": "hiveos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:demo": "DEMO_FIXTURES_ENABLED=true next dev --hostname 127.0.0.1",
    "demo:provision": "DEMO_FIXTURES_ENABLED=true tsx scripts/dev/provision-local-demo.ts",
    "build": "next build && node scripts/build/scrub-standalone-env.mjs && node scripts/build/prepare-standalone-assets.mjs",
    "start": "node scripts/build/start-standalone.mjs",
    "typecheck": "tsc --noEmit",
    "research:check": "node scripts/research/check.mjs",
    "research:replay": "node --import tsx scripts/research/replay.mts",
    "research:lean": "node --import tsx scripts/research/lean.mts",
    "research:lrc": "python3 -I -S -B scripts/research/lrc-method.py",
    "lint": "eslint",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "HIVE_TEST_SCOPE=product vitest run --project unit",
    "test:archive": "HIVE_TEST_SCOPE=archive vitest run --project unit",
    "test:unit:all": "HIVE_TEST_SCOPE=all vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:integration:strict": "node --throw-deprecation ./node_modules/vitest/vitest.mjs run --project integration",
    "test:dependency-policy": "vitest run --project unit tests/unit/dependency-policy.test.ts",
    "check:dependency-policy": "node scripts/ci/check-dependency-policy.mjs",
    "test:e2e": "npm run build && node --throw-deprecation ./node_modules/@playwright/test/cli.js test",
    "test:prod-startup": "node scripts/test/prod-fail-closed.mjs",
    "test:load-local": "node scripts/test/load-baseline.mjs",
    "test:scale-projection": "vitest run --project scale",
    "test:sandbox-container": "RUN_DOCKER_SANDBOX_TESTS=1 vitest run --project container",
    "scale:smoke": "node scripts/scale/tip023h-certify.mjs --confirm-run=TIP-023H --duration-seconds=5 --report=/tmp/hiveos-tip023h-smoke.json",
    "scale:certify": "node scripts/scale/tip023h-certify.mjs --confirm-run=TIP-023H",
    "pilot:readiness": "node scripts/operations/pilot-readiness.mjs",
    "math-pilot:readiness": "node scripts/operations/math-pilot-readiness.mjs",
    "math-pilot:residual-survey": "tsx scripts/operations/erdos-straus-residual-survey.ts",
    "service-principal:provision": "node scripts/operations/provision-service-principal.mjs",
    "worker:research-sandbox": "tsx scripts/workers/research-sandbox-worker.ts",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:setup-role": "node scripts/db/apply-app-role.mjs",
    "db:bootstrap": "prisma migrate deploy && node scripts/db/apply-app-role.mjs",
    "db:backup:local": "node scripts/db/backup-local.mjs",
    "db:restore:local": "node scripts/db/restore-local.mjs",
    "db:rehearse:tip019": "node scripts/db/rehearse-tip019.mjs",
    "db:rehearse:tip023a": "node scripts/db/rehearse-tip023a.mjs",
    "db:rehearse:tip023b": "node scripts/db/rehearse-tip023b.mjs",
    "db:rehearse:tip023c": "node scripts/db/rehearse-tip023c.mjs",
    "db:rehearse:tip023d": "node scripts/db/rehearse-tip023d.mjs",
    "db:rehearse:tip023e": "node scripts/db/rehearse-tip023e.mjs",
    "db:rehearse:tip023g": "node scripts/db/rehearse-tip023g.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1090.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "better-auth": "1.6.23",
    "docx": "^9.7.1",
    "katex": "0.18.9",
    "lucide-react": "1.25.0",
    "next": "16.3.8",
    "nodemailer": "9.0.3",
    "notosans-fontface": "^1.3.0",
    "pdfkit": "^0.19.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsx": "4.23.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "7.0.4",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "pg": "8.22.0",
    "prisma": "7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "overrides": {
    "find-my-way": "9.7.0",
    "postcss": "8.5.25",
    "sharp": "0.35.5"
  }
}
